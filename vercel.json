{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://personal-portfolio-tx67.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://personal-portfolio-tx67.onrender.com/uploads/:path*"
    }
  ]
}
